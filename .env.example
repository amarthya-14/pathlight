# --- Database (MongoDB) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=pathlight

# --- Redis ---
REDIS_PORT=6379

# --- Backend (FastAPI + LangGraph + MCP) ---
UPLOADS_ROOT=./data/uploads
BACKEND_PORT=8000
JWT_SECRET=changeme

# --- LLM (Gemini) ---
# Model names verified current as of Aug 2026 — check https://ai.google.dev/gemini-api/docs/models
# before changing these; gemini-2.0-flash is already retired and gemini-2.5-pro is
# scheduled for shutdown Oct 2026, so this project intentionally avoids both.
GOOGLE_API_KEY=changeme
LLM_MODEL_SMALL=gemini-3.1-flash-lite
LLM_MODEL_STRONG=gemini-3.6-flash
# ^ Not a typo: the entire gemini-3.1-pro family requires a billing-enabled Google
# account (free-tier quota is 0 for it) — confirmed via a real smoke test, not assumed.
# See docs/ARCHITECTURE.md §15 and app/core/config.py's comment for the full story.
EMBEDDING_MODEL=gemini-embedding-001
# Extra shared Gemini keys (comma-separated, e.g. from other free projects) tried after
# GOOGLE_API_KEY runs out of quota. Students can also add their own keys (any provider) in
# Profile -> Your AI keys; those are always tried first for their requests.
GOOGLE_API_KEYS=
# Last-resort models after the strong and small ones (comma-separated), e.g. gemini-2.5-flash
LLM_EXTRA_FALLBACK_MODELS=

# --- Vector DB (Chroma) ---
CHROMA_PERSIST_DIR=./chroma_data

# --- MCP Tools ---
# Gmail MCP (Gate 10) — Google Cloud OAuth client (type "Web application"). Add
# GMAIL_OAUTH_REDIRECT_URI below as an Authorized redirect URI on that client, and enable
# the Gmail API for the project. See docs/AUTONOMOUS_APPLICATIONS.md §12.
GMAIL_MCP_CLIENT_ID=
GMAIL_MCP_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/callback
FRONTEND_URL=http://localhost:3000
# Fernet key for OAuth tokens at rest — REQUIRED for Gmail; never commit a real one. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
GMAIL_POLL_ENABLED=true
GMAIL_POLL_INTERVAL_SECONDS=86400
# Comma-separated job-alert senders the poller reads (inspection-based starting list):
# GMAIL_ALERT_SENDERS=jobalerts-noreply@linkedin.com,jobs-noreply@linkedin.com,noreply@naukri.com
GITHUB_MCP_TOKEN=
CALENDAR_MCP_CLIENT_ID=
CALENDAR_MCP_CLIENT_SECRET=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- CORS (Gate 8) ---
# Comma-separated list of origins the backend accepts browser requests from. Must match
# wherever the frontend actually runs — a real bug (405 on every request) was caught by
# manually testing the frontend in a browser when this didn't exist yet.
CORS_ORIGINS=http://localhost:3000
# Optional regex for extra origins, e.g. Vercel preview URLs (Gate 11):
# CORS_ORIGIN_REGEX=^https://pathlight-[a-z0-9-]+\.vercel\.app$

# --- Deployment (Gate 11, see docs/DEPLOYMENT.md) ---
# "production" makes the backend refuse to start with insecure defaults (weak JWT_SECRET,
# localhost Mongo, localhost FRONTEND_URL, ...).
ENVIRONMENT=development
# Shared secret for the GitHub Actions cron that wakes the free-tier backend and polls Gmail.
CRON_SECRET=

# --- Job aggregators (optional, free) — the main source of FRESHER jobs in India ---
# Adzuna: sign up at https://developer.adzuna.com (keys shown instantly)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble: request at https://jooble.org/api/about (key arrives by email)
JOOBLE_API_KEY=

# --- Sign-in, email, admin (optional) ---
# "Continue with Google": defaults to the Gmail OAuth client above. For a public launch use a
# separate PUBLISHED OAuth client (scopes openid/email/profile need no Google verification).
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Password-reset emails over SMTP (e.g. a Gmail account with an App Password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Comma-separated emails that can open /admin
ADMIN_EMAILS=
# Frontend: shown on the Privacy and Terms pages
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Forwarded job alerts (optional) — see docs/DEPLOYMENT.md and infra/email-worker/ ---
INBOUND_EMAIL_DOMAIN=
INBOUND_WEBHOOK_SECRET=

