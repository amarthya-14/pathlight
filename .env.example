# --- Database (MongoDB) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=pathlight

# --- Redis ---
REDIS_PORT=6379

# --- Backend (FastAPI + LangGraph + MCP) ---
UPLOADS_ROOT=./data/uploads
BACKEND_PORT=8000
JWT_SECRET=changeme

# --- LLM (Gemini) ---
# Model names verified current as of Aug 2026 — check https://ai.google.dev/gemini-api/docs/models
# before changing these; gemini-2.0-flash is already retired and gemini-2.5-pro is
# scheduled for shutdown Oct 2026, so this project intentionally avoids both.
GOOGLE_API_KEY=changeme
LLM_MODEL_SMALL=gemini-3.1-flash-lite
LLM_MODEL_STRONG=gemini-3.1-pro
EMBEDDING_MODEL=gemini-embedding-001

# --- Vector DB (Chroma) ---
CHROMA_PERSIST_DIR=./chroma_data

# --- MCP Tools ---
GMAIL_MCP_CLIENT_ID=
GMAIL_MCP_CLIENT_SECRET=
GITHUB_MCP_TOKEN=
CALENDAR_MCP_CLIENT_ID=
CALENDAR_MCP_CLIENT_SECRET=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
